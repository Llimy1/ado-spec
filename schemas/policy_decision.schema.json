{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADO Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_key",
    "transition_request_key",
    "decision",
    "reason",
    "evaluated_rules",
    "missing_requirements",
    "safety_events",
    "required_human_action",
    "expires_at",
    "decided_by",
    "decided_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "decision_key": { "type": "string" },
    "transition_request_key": { "type": "string" },
    "decision": { "enum": ["allowed", "denied", "human_required", "incident_hold", "blocked"] },
    "reason": { "type": "string" },
    "evaluated_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_key", "result", "reason"],
        "properties": {
          "rule_key": { "type": "string" },
          "result": { "enum": ["passed", "failed", "not_applicable", "warning"] },
          "reason": { "type": "string" }
        }
      }
    },
    "missing_requirements": { "type": "array", "items": { "type": "string" } },
    "safety_events": { "type": "array", "items": { "type": "string" } },
    "required_human_action": { "type": ["string", "null"] },
    "expires_at": { "type": ["string", "null"] },
    "decided_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_key"],
      "properties": {
        "actor_type": { "enum": ["policy_engine", "human", "system"] },
        "actor_key": { "type": "string" }
      }
    },
    "decided_at": { "type": "string" }
  }
}
