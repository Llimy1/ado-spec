{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ado.local/schemas/project_constraint_profile.schema.json",
  "title": "ProjectConstraintProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_key",
    "profile_version",
    "status",
    "identity",
    "components",
    "design_constraints",
    "architecture_constraints",
    "verification_profile",
    "forbidden_behavior",
    "open_questions"
  ],
  "properties": {
    "project_key": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "ready_for_human_review", "approved", "rejected", "superseded"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "problem", "primary_users", "must_not_become"],
      "properties": {
        "name": { "type": "string" },
        "problem": { "type": "string" },
        "primary_users": {
          "type": "array",
          "items": { "type": "string" }
        },
        "secondary_users": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "must_not_become": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_key", "component_type", "repository_key"],
        "properties": {
          "component_key": { "type": "string" },
          "component_type": {
            "type": "string",
            "enum": ["app", "web", "server", "admin", "infra", "design_asset", "docs", "research", "other"]
          },
          "repository_key": { "type": "string" },
          "root_path": { "type": "string", "default": "." },
          "runtime": { "type": "string", "default": "" }
        }
      }
    },
    "design_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "ux_principles", "visual_rules", "forbidden_styles"],
      "properties": {
        "tone": { "type": "string" },
        "ux_principles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "visual_rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_styles": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "architecture_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_rules", "component_rules", "data_rules", "dependency_rules"],
      "properties": {
        "repository_rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "component_rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data_rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependency_rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "verification_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_commands", "human_checklist_defaults", "required_evidence"],
      "properties": {
        "required_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "human_checklist_defaults": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "forbidden_behavior": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
