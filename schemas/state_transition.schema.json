{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADO State Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_transition_key",
    "transition_request_key",
    "policy_decision_key",
    "evidence_gate_result_key",
    "target",
    "from_status",
    "to_status",
    "transition_name",
    "applied_by",
    "reason",
    "audit_event_key",
    "applied_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "state_transition_key": { "type": "string" },
    "transition_request_key": { "type": "string" },
    "policy_decision_key": { "type": "string" },
    "evidence_gate_result_key": { "type": "string" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_type", "target_key"],
      "properties": {
        "target_type": { "type": "string" },
        "target_key": { "type": "string" }
      }
    },
    "from_status": { "type": "string" },
    "to_status": { "type": "string" },
    "transition_name": { "type": "string" },
    "applied_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_key"],
      "properties": {
        "actor_type": { "const": "state_machine" },
        "actor_key": { "type": "string" }
      }
    },
    "reason": { "type": "string" },
    "audit_event_key": { "type": "string" },
    "applied_at": { "type": "string" }
  }
}
