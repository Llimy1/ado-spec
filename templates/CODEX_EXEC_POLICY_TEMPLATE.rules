# ADO Codex exec policy template.
#
# Codex rules are a secondary defense layer. ADO must still enforce policy
# through runner preflight, sandboxing, allowed_paths, allowed_commands,
# post-run validation, Policy Engine, and State Machine gates.
#
# This file is intended to be installed under an active Codex config layer:
#
#   {CODEX_HOME}/rules/ado.rules
#   or trusted project .codex/rules/ado.rules

prefix_rule(
    pattern = ["rm"],
    decision = "forbidden",
    justification = "ADO forbids destructive removal commands in agent runs. Use ADO-managed cleanup jobs instead.",
    match = [
        "rm -rf build",
        "rm file.txt",
    ],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "ADO agent runs must not request privilege escalation.",
    match = [
        "sudo npm install -g something",
    ],
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "forbidden",
    justification = "ADO forbids git reset in agent runs. Use GitWorkspaceManager recovery instead.",
    match = [
        "git reset --hard HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "ADO forbids git clean in agent runs. Dirty worktrees require explicit recovery.",
    match = [
        "git clean -fd",
    ],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "ADO forbids force pushes.",
    match = [
        "git push --force origin branch",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "main"],
    decision = "forbidden",
    justification = "ADO never pushes to main.",
    match = [
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", "integrate"],
    decision = "forbidden",
    justification = "ADO never pushes directly to integrate.",
    match = [
        "git push origin integrate",
    ],
)

prefix_rule(
    pattern = ["git", "switch", "main"],
    decision = "forbidden",
    justification = "ADO implementation jobs must not switch to main.",
    match = [
        "git switch main",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "main"],
    decision = "forbidden",
    justification = "ADO implementation jobs must not checkout main.",
    match = [
        "git checkout main",
    ],
)

prefix_rule(
    pattern = ["git", "merge"],
    decision = "forbidden",
    justification = "ADO does not merge branches in agent runs.",
    match = [
        "git merge feature",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "ADO v1 never merges pull requests automatically.",
    match = [
        "gh pr merge 123",
    ],
)

prefix_rule(
    pattern = ["kubectl", "apply"],
    decision = "forbidden",
    justification = "ADO v1 does not apply infrastructure changes automatically.",
    match = [
        "kubectl apply -f deploy.yaml",
    ],
)

prefix_rule(
    pattern = ["terraform", "apply"],
    decision = "forbidden",
    justification = "ADO v1 allows planning but not infrastructure apply.",
    match = [
        "terraform apply",
    ],
)

prefix_rule(
    pattern = ["docker", "push"],
    decision = "forbidden",
    justification = "ADO v1 does not publish artifacts automatically.",
    match = [
        "docker push image",
    ],
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "forbidden",
    justification = "ADO v1 does not publish packages automatically.",
    match = [
        "npm publish",
    ],
)

prefix_rule(
    pattern = ["curl"],
    decision = "prompt",
    justification = "Network fetches require explicit ADO policy approval and destination classification.",
    match = [
        "curl https://example.com",
    ],
)

prefix_rule(
    pattern = ["wget"],
    decision = "prompt",
    justification = "Network fetches require explicit ADO policy approval and destination classification.",
    match = [
        "wget https://example.com/file",
    ],
)
